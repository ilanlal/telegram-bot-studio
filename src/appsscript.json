{
  "timeZone": "America/New_York",
  "exceptionLogging": "STACKDRIVER",
  "runtimeVersion": "V8",
  "webapp": {
    "executeAs": "USER_DEPLOYING",
    "access": "ANYONE_ANONYMOUS"
  },
  "oauthScopes": [
    "https://www.googleapis.com/auth/script.locale",
    "https://www.googleapis.com/auth/spreadsheets.currentonly",
    "https://www.googleapis.com/auth/script.external_request"
  ],
  "addOns": {
    "common": {
      "name": "Telegram Bot Studio (TBS)",
      "logoUrl": "https://lh3.googleusercontent.com/dSbCFuDPREqPoqeGFnEYTE4Y_iTNGWtMFTIEbHKeq648a3Muh8U6",
      "layoutProperties": {
        "primaryColor": "#1976d2",
        "secondaryColor": "#0f9d58"
      },
      "openLinkUrlPrefixes": [
        "https://raw.githubusercontent.com/ilanlal/",
        "https://www.github.com/ilanlal/",
        "https://github.com/ilanlal/",
        "https://www.easyadm.com",
        "https://easyadm.com",
        "https://t.me/",
        "https://telegram.me/"
      ],
      "homepageTrigger": {
        "runFunction": "Addon.Home.Controller.PushHomeCard"
      },
      "useLocaleFromApp": true,
      "universalActions": [
        {
          "label": "Profile",
          "runFunction": "Addon.UserProfile.Controller.PushHomeCard"
        },
        {
          "label": "Settings",
          "runFunction": "Addon.Settings.Controller.PushHomeCard"
        },
        {
          "label": "Help",
          "runFunction": "Addon.Home.Controller.PushHelpCard"
        },
        {
          "label": "About",
          "runFunction": "Addon.Home.Controller.PushAboutCard"
        },
        {
          "label": "Visit Website",
          "openLink": "https://www.easyadm.com/add-ons/telegram-bot-studio"
        }
      ]
    },
    "sheets": {}
  },
  "urlFetchWhitelist": [
    "https://api.telegram.org/",
    "https://generativelanguage.googleapis.com/",
    "https://www.googleapis.com/"
  ]
}